{
  "name": "saltedfishcloud-frontend",
  "version": "3.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "vite preview",
    "build": "vite build && cd sfc-oauth && vite build",
    "build-oauth": "cd sfc-oauth && vite build",
    "dev": "vite --host",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "git checkout deploy && git merge develop --no-ff && git push && git push origin && git push github && git checkout develop",
    "build-ext": "node scripts/build-ext.mjs",
    "build-ext-all": "node scripts/build-ext.mjs --all",
    "build-ext-demo": "node scripts/build-ext.mjs demo",
    "build-ext-video-enhance": "node scripts/build-ext.mjs video-enhance",
    "build-ext-jntm": "node scripts/build-ext.mjs jntm",
    "build-ext-quick-share": "node scripts/build-ext.mjs quick-share",
    "build-ext-network-tools": "node scripts/build-ext.mjs network-tools",
    "build-ext-web-shell": "node scripts/build-ext.mjs web-shell",
    "build-ext-static-publish": "node scripts/build-ext.mjs static-publish",
    "build-ext-only-office": "node scripts/build-ext.mjs only-office",
    "build-ext-rtc": "node scripts/build-ext.mjs rtc",
    "build-ext-webdav": "node scripts/build-ext.mjs webdav",
    "build-ext-mcp": "node scripts/build-ext.mjs mcp",
    "build-ext-data-manager": "node scripts/build-ext.mjs data-manager",
    "build-ext-pxe-boot": "node scripts/build-ext.mjs pxe-boot",
    "copy-to-backend": "node --env-file .env scripts/copy-to-backend.js",
    "build-and-copy-to-backend": "vite build && cd sfc-oauth && vite build && cd .. && node --env-file .env scripts/copy-to-backend.js"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.5",
    "dplayer": "^1.27.1",
    "echarts": "^5.4.2",
    "highlight.js": "^11.10.0",
    "js-md5": "^0.7.3",
    "markdown-it": "^13.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "monaco-editor": "^0.55.1",
    "qs": "^6.10.3",
    "roboto-fontface": "*",
    "sfc-common": "file:sfc-common",
    "vue": "^3.5.28",
    "vue-router": "^4.0.14",
    "vuetify": "^4.0.0",
    "vuex": "^4.0.2",
    "webfontloader": "^1.0.0"
  },
  "devDependencies": {
    "@mdi/font": "^6.6.96",
    "@types/dplayer": "^1.25.2",
    "@types/js-md5": "^0.4.3",
    "@types/markdown-it": "^12.2.3",
    "@types/node": "^25.8.0",
    "@types/qs": "^6.9.7",
    "@types/webfontloader": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "@typescript-eslint/parser": "^5.22.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^8.14.0",
    "eslint-plugin-vue": "^8.7.1",
    "sass-embedded": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.9",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.4"
  }
}
